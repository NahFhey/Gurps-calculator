{
  "name": "gurps-party-tool",
  "version": "2.5.0",
  "description": "GURPS Party Management Tool - Inventory, Cooking, Crafting, Alchemy, Gathering & Performance Monitoring",
  "author": {
    "name": "Devin"
  },
  "main": "electron-dist/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "icon:generate": "python scripts/generate_app_icon.py",
    "electron:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop_running_desktop_app.ps1",
    "electron:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create_desktop_shortcut.ps1",
    "preview": "vite preview",
    "lint": "eslint src/**/*.{js,jsx}",
    "lint:fix": "eslint src/**/*.{js,jsx} --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "server:dev": "cd server && npm run dev",
    "server:build": "cd server && npm run build",
    "start": "cd server && npm start",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run build && npm run server:build && npm run electron:build && electron electron-dist/main.js",
    "electron:pack": "npm run electron:stop && npm run build && npm run server:build && npm run electron:build && electron-builder --dir",
    "electron:dist": "npm run electron:stop && npm run build && npm run server:build && npm run electron:build && electron-builder"
  },
  "dependencies": {
    "dexie": "^4.3.0",
    "immer": "^11.1.3",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.4.16",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.32",
    "prettier": "^3.8.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
